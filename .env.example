# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for the cocoa-inventory backend
# Copy this file to .env and fill in real values for local development.
# On Render, set these in the Dashboard → Your Service → Environment.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime mode
NODE_ENV=development

# Server port (Render sets this automatically in production — omit on Render)
PORT=5000

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED. Use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_secret

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# REQUIRED. Full connection string — Render provides this automatically when a
# Postgres database is attached to the service.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── CORS ──────────────────────────────────────────────────────────────────────
# REQUIRED in production. Set to your Vercel frontend URL (no trailing slash).
# Comma-separate multiple origins if you have more than one.
CORS_ORIGIN=https://cocoa-inventory.vercel.app

# Origins allowed in non-production environments (comma-separated).
# Defaults to localhost:3000, localhost:5001, 127.0.0.1:3000 if omitted.
# DEV_CORS_ORIGINS=http://localhost:3000,http://localhost:5001

# ── bcrypt ────────────────────────────────────────────────────────────────────
# Salt rounds used when hashing passwords. Must be 10–20. Defaults to 10.
# Increase to 12 for stronger hashing (adds ~4× hash time per round above 10).
# BCRYPT_ROUNDS=10

# ── Rate limiting (login endpoint) ────────────────────────────────────────────
# Window length in milliseconds. Defaults: 900000ms prod / 120000ms dev.
# RATE_LIMIT_WINDOW_MS=900000
# Maximum login attempts per window. Defaults: 5 prod / 20 dev.
# RATE_LIMIT_MAX=5

# ── Audit log ─────────────────────────────────────────────────────────────────
# Maximum rows returned by GET /audit-logs. Defaults to 500; hard cap 1000.
# AUDIT_LOG_LIMIT=500

# ── Admin seed (used only on first DB initialisation) ─────────────────────────
# Override these to avoid deploying with default credentials.
# IMPORTANT: Change the admin password after first login regardless.
# ADMIN_STAFF_NAME=admin
# ADMIN_STAFF_ID=ADMIN001
# ADMIN_PASSWORD_HASH=<bcrypt hash of your chosen default password>
